# 复制本文件为 .env 并按实际值填写；.env 已被 .gitignore 忽略，切勿提交真实密钥。
# ⚠️ 安全提示：仓库历史/本地曾出现真实 Neon 连接串、JWT 密钥与 Cloudflare R2 密钥，
#    请尽快在对应控制台轮换（Regenerate）这些凭据后再使用。

# PostgreSQL 数据库连接串（Neon / 本地均可）。建议显式指定时区为 UTC。
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT 签名密钥（请使用足够复杂的随机串）
JWT_SECRET=change_me_to_a_long_random_secret

# 额外允许跨域的前端来源（逗号分隔），会追加到内置白名单
# 例如：FRONTEND_ORIGINS=https://your-new-domain.com,http://localhost:5175
FRONTEND_ORIGINS=

# 初始管理员引导：库中尚无管理员时，启动会用下面的账号密码创建（或提升）管理员。
# 生产环境必须设置为强密码；留空则不会自动创建，需自行在数据库中将某账号 is_admin 置 TRUE。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 数据库连接池上限（每进程）
DB_POOL_MAX_CONN=20

# asyncpg 预编译语句缓存大小。直连 Neon 主库用默认 100；
# 若使用 pgbouncer / Neon 的 -pooler 连接串（事务池模式），必须改为 0。
DB_STATEMENT_CACHE_SIZE=100

# 图片上传大小上限（字节，默认 5MB）
MAX_UPLOAD_BYTES=5242880

# 热点新闻定时爬取：是否启用（默认开）、抓取间隔分钟数（默认 15）
NEWS_CRAWL_ENABLED=true
NEWS_CRAWL_INTERVAL_MINUTES=15

# Cloudflare R2 对象存储（用于头像/图片上传）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=drive-space
R2_PUBLIC_URL=
